# Salin menjadi deploy/.env di VPS lalu isi semuanya. JANGAN di-commit.

# Domain yang sudah diarahkan (DNS A record) ke IP VPS, tanpa https://
DOMAIN=app.contohsekolah.sch.id

# Password database (buat acak, misalnya: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Minimal 32 karakter acak (misalnya: openssl rand -hex 48)
JWT_SECRET=

# Cloudinary — disarankan folder terpisah dari development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=growth-together-prod

# Akun admin pertama (dibuat otomatis saat pertama kali menyala, hanya jika belum ada admin)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
