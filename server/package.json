{
  "name": "growth-together-server",
  "version": "1.0.0",
  "description": "Growth Together API",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon bin/www.js",
    "start": "node bin/www.js",
    "db:setup": "sequelize db:create && sequelize db:migrate && sequelize db:seed:all",
    "db:migrate": "sequelize db:migrate",
    "db:reset": "sequelize db:migrate:undo:all && sequelize db:migrate && sequelize db:seed:all"
  },
