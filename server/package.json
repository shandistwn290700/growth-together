{
  "name": "growth-together-server",
  "version": "1.0.0",
  "description": "Growth Together API",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon bin/www.js",
    "start": "node bin/www.js",
    "db:setup": "sequelize db:create && sequelize db:migrate && sequelize db:seed:all",
    "db:migrate": "sequelize db:migrate",
    "db:reset": "sequelize db:migrate:undo:all && sequelize db:migrate && sequelize db:seed:all",
    "check:cloudinary": "node scripts/check-cloudinary.js",
    "db:seed": "sequelize db:seed:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
