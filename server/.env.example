PORT=3000
# Hanya untuk development (Vite di port 5173). Kosongkan di produksi.
CLIENT_URL=http://localhost:5173

# --- Produksi (hosting) ---
# NODE_ENV=production
# DATABASE_URL=postgres://user:password@host:5432/nama_db
# DB_SSL=true   # isi jika database mewajibkan koneksi SSL

# --- PostgreSQL lokal (development) ---
DB_USERNAME=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=growth_together_dev
DB_NAME_TEST=growth_together_test

# Isi dengan string acak panjang, misalnya hasil:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary (penyimpanan foto/video). Ambil dari console.cloudinary.com.
# API Secret hanya boleh ada di sini, jangan pernah ditaruh di folder client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=growth-together

# Akun admin pertama (dipakai oleh seeder)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
